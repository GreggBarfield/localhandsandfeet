<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS site for Local Hands & Feet. IIS only passes traffic through to the Node service on port 4400.
  Node serves the whole site, so nothing else is needed here.
  Same pattern as the Trainers Portal (port 4300).
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="ProxyToNode" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://localhost:4400/{R:1}" />
          <serverVariables>
            <!-- Tells the app the visitor used https, so the login cookie is allowed to be set -->
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
        </rule>
      </rules>
    </rewrite>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
