# Copy this file to .env on the server and fill in real values. Never commit .env.

# Port the Node service listens on (IIS proxies to it; deploy.ps1 health-checks it)
PORT=4400
NODE_ENV=production

# Postgres
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/localhandsandfeet

# Site
SITE_URL=https://localhandsandfeet.org
AUTH_SECRET=

# Stripe (donations: one-time and recurring)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Email through SMTP2GO (same key as the other apps). MAIL_FROM must be a sender verified in SMTP2GO.
# MAIL_TO is where website messages are delivered.
SMTP2GO_API_KEY=
MAIL_FROM=fmcmissions@fmcbryan.org
MAIL_FROM_NAME=Local Hands and Feet
MAIL_TO=fmcmissions@fmcbryan.org

# Cloudflare Turnstile (spam protection on forms)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
